0;31m     \u001b[0;32mreturn\u001b[0m \u001b[0mtorch\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0membedding\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0mweight\u001b[0m\u001b[0;34m,\u001b[0m \u001b[0minput\u001b[0m\u001b[0;34m,\u001b[0m \u001b[0mpadding_idx\u001b[0m\u001b[0;34m,\u001b[0m \u001b[0mscale_grad_by_freq\u001b[0m\u001b[0;34m,\u001b[0m \u001b[0msparse\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0m\u001b[1;32m   2543\u001b[0m \u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m   2544\u001b[0m \u001b[0;34m\u001b[0m\u001b[0m\n","\u001b[0;31mAcceleratorError\u001b[0m: CUDA error: no kernel image is available for execution on the device\nSearch for `cudaErrorNoKernelImageForDevice' in https://docs.nvidia.com/cuda/cuda-runtime-api/group__CUDART__TYPES.html for more information.\nCUDA kernel errors might be asynchronously reported at some other API call, so the stacktrace below might be incorrect.\nFor debugging consider passing CUDA_LAUNCH_BLOCKING=1\nCompile with `TORCH_USE_CUDA_DSA` to enable device-side assertions.\n"],"ename":"AcceleratorError","evalue":"CUDA error: no kernel image is available for execution on the device\nSearch for `cudaErrorNoKernelImageForDevice' in https://docs.nvidia.com/cuda/cuda-runtime-api/group__CUDART__TYPES.html for more information.\nCUDA kernel errors might be asynchronously reported at some other API call, so the stacktrace below might be incorrect.\nFor debugging consider passing CUDA_LAUNCH_BLOCKING=1\nCompile with `TORCH_USE_CUDA_DSA` to enable device-side assertions.\n","output_type":"error"}],"execution_count":7},{"cell_type":"code","source":"#!/usr/bin/env python3\nimport os, torch\nfrom typing import List, Dict, Any\nfrom operator import itemgetter\n\nfrom transformers import AutoTokenizer, AutoModelForCausalLM, BitsAndBytesConfig\nfrom langchain_community.vectorstores import Chroma\nfrom langchain_community.embeddings import HuggingFaceEmbeddings\nfrom langchain_core.runnables import RunnableParallel, RunnableLambda\n\nMODEL_NAME = os.environ.get(\"MISTRAL_LOCAL_MODEL\", \"mistralai/Mistral-7B-Instruct-v0.2\")\nEMB_MODEL = \"sentence-transformers/all-MiniLM-L6-v2\"\nDB_DIR = \"gita_db\"\n\ndef load_model(model_name: str):\n    use_4bit = True\n    bnb_cfg = None\n    if use_4bit:\n        try:\n            bnb_cfg = BitsAndBytesConfig(\n                load_in_4bit=True,\n                bnb_4bit_quant_type=\"nf4\",\n                bnb_4bit_use_double_quant=True,\n                bnb_4bit_compute_dtype=torch.bfloat16\n            )\n        except Exception:\n            bnb_cfg = None\n\n    tok = AutoTokenizer.from_pretrained(model_name, use_fast=True)\n    if tok.pad_token is None:\n        tok.pad_token = tok.eos_token\n\n    if bnb_cfg is not None:\n        model = AutoModelForCausalLM.from_pretrained(\n            model_name,\n            torch_dtype=torch.bfloat16,\n            quantization_config=bnb_cfg,\n            device_map=\"auto\"\n        )\n    else:\n        # Fallback (needs more VRAM)\n        model = AutoModelForCausalLM.from_pretrained(\n            model_name,\n            torch_dtype=torch.bfloat16 if torch.cuda.is_available() else torch.float32,\n            device_map=\"auto\"\n        )\n    return tok, model\n\ntokenizer, model = load_model(MODEL_NAME)\n\nembeddings = HuggingFaceEmbeddings(model_name=EMB_MODEL)\nvectordb = Chroma(\n    persist_directory=DB_DIR,\n    embedding_function=embeddings,\n    collection_name=\"gita\"\n)\nretriever = vectordb.as_retriever(search_type=\"mmr\", search_kwargs={\"k\": 4, \"lambda_mult\": 0.5})\n\nSYSTEM = (\n    \"You are a Bhagavad Gita philosophy assistant.\\n\"\n    \"Answer with clear, compassionate reasoning grounded ONLY in the provided context.\\n\"\n    \"If unclear from context, say you don't know and offer closest relevant verses.\\n\\n\"\n    \"CITATIONS:\\n\"\n    \"- After claims that depend on the text, add inline citations like (Ch 2:V 47 | BG-2-47).\\n\"\n    \"- Cite multiple verses if needed. Never invent verses/content.\\n\\n\"\n    \"STYLE: Be concise (3–6 short paragraphs).\"\n)\n\ndef _s(x: Any) -> str:\n    return x if isinstance(x, str) else (\"\" if x is None else str(x))\n\ndef format_docs(docs):\n    blocks = []\n    for d in docs:\n        m = d.metadata or {}\n        cid = _s(m.get(\"id\")); ch = _s(m.get(\"chapter\")); vs = _s(m.get(\"verse\"))\n        blocks.append(f\"[{cid}] Ch {ch} | V {vs}\\n{_s(d.page_content)}\")\n    return \"\\n\\n---\\n\\n\".join(blocks)\n\n# Only the string question enters the retriever (prevents dict.replace issues)\nquestion_only = RunnableLambda(lambda x: x[\"question\"])\ninputs = RunnableParallel(\n    context=question_only | retriever | format_docs,\n    question=itemgetter(\"question\"),\n    chat_history=itemgetter(\"chat_history\")\n)\n\ndef mistral_generate(payload: Dict[str, Any]) -> str:\n    # Build Mistral chat template using tokenizer (supports apply_chat_template)\n    messages = [{\"role\":\"system\",\"content\":SYSTEM}]\n\n    for turn in payload.get(\"chat_history\", []):\n        role = turn.get(\"role\",\"user\")\n        content = _s(turn.get(\"content\",\"\"))\n        if content: messages.append({\"role\": role, \"content\": content})\n\n    user_msg = (\n        f\"User question: {payload['question']}\\n\\n\"\n        f\"Use these retrieved notes:\\n{payload['context']}\\n\\n\"\n        f\"Now answer faithfully with citations.\"\n    )\n    messages.append({\"role\":\"user\",\"content\":user_msg})\n\n    prompt = tokenizer.apply_chat_template(\n        messages, tokenize=False, add_generation_prompt=True\n    )\n    inputs_tok = tokenizer(prompt, return_tensors=\"pt\").to(model.device)\n\n    with torch.no_grad():\n        out = model.generate(\n            **inputs_tok,\n            max_new_tokens=512,\n            do_sample=False,\n            temperature=0.2,\n            top_p=0.95,\n            repetition_penalty=1.1,\n            eos_token_id=tokenizer.eos_token_id,\n            pad_token_id=tokenizer.pad_token_id\n        )\n\n    gen_ids = out[0][inputs_tok[\"input_ids\"].shape[1]:]\n    text = tokenizer.decode(gen_ids, skip_special_tokens=True)\n    return text.strip()\n\nchain = inputs | RunnableLambda(mistral_generate)\n\ndef main():\n    print(\"Bhagavad Gita RAG (Transformers + Mistral-7B-Instruct). Type 'exit' to quit.\")\n    chat_history: List[Dict[str, str]] = []\n    while True:\n        try:\n            q = input(\"\\nYou: \").strip()\n        except (EOFError, KeyboardInterrupt):\n            break\n        if not q or q.lower() in {\"exit\",\"quit\"}:\n            break\n        res = chain.invoke({\"question\": q, \"chat_history\": chat_history})\n        print(\"\\nAssistant:\", res)\n        chat_history = (chat_history + [{\"role\":\"user\",\"content\":q},\n                                        {\"role\":\"assistant\",\"content\":res}])[-12:]\n\nif __name__ == \"__main__\":\n    main()\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-12-19T03:11:24.990906Z","iopub.status.idle":"2025-12-19T03:11:24.991206Z","shell.execute_reply.started":"2025-12-19T03:11:24.991079Z","shell.execute_reply":"2025-12-19T03:11:24.991094Z"},"collapsed":true,"jupyter":{"outputs_hidden":true}},"outputs":[],"execution_count":null}]}