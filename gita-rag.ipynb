status.busy":"2025-12-19T03:11:11.087716Z","iopub.execute_input":"2025-12-19T03:11:11.088014Z","iopub.status.idle":"2025-12-19T03:11:11.579472Z","shell.execute_reply.started":"2025-12-19T03:11:11.087991Z","shell.execute_reply":"2025-12-19T03:11:11.578867Z"},"collapsed":true,"jupyter":{"outputs_hidden":true}},"outputs":[],"execution_count":6},{"cell_type":"code","source":"#!/usr/bin/env python3\nimport json\nfrom pathlib import Path\nfrom typing import Any, Dict, List\n\nimport pandas as pd\nfrom langchain_text_splitters import RecursiveCharacterTextSplitter\nfrom langchain_community.embeddings import HuggingFaceEmbeddings\nfrom langchain_community.vectorstores import Chroma\nfrom langchain_core.documents import Document\n\nDATA = Path(\"/kaggle/input/bhagwad-gita-json/Bhagwad_Gita.json\")\nDB_DIR = Path(\"gita_db\")\nEMB_MODEL = \"sentence-transformers/all-MiniLM-L6-v2\"\n\ndef to_str(x: Any) -> str:\n    if isinstance(x, str): return x\n    if x is None: return \"\"\n    if isinstance(x, (dict, list)): return json.dumps(x, ensure_ascii=False)\n    return str(x)\n\ndef join_nonempty(parts: List[str], sep: str = \"\\n\") -> str:\n    return sep.join([p for p in parts if isinstance(p, str) and p.strip()])\n\ndef build_content(row: Dict[str, Any]) -> str:\n    parts = [\n        f\"ID: {to_str(row.get('id'))}\",\n        f\"Chapter {to_str(row.get('chapter'))}, Verse {to_str(row.get('verse'))}\",\n        f\"Sanskrit: {to_str(row.get('sanskrit'))}\",\n        f\"Translation: {to_str(row.get('translation'))}\",\n        f\"Summary: {to_str(row.get('summary'))}\",\n        f\"Context: {to_str(row.get('therapy_context'))}\",\n        f\"Keywords: {to_str(row.get('keywords'))}\",\n    ]\n    content = join_nonempty(parts, \"\\n\")\n    assert isinstance(content, str)\n    return content\n\ndef load_dataframe():\n    with DATA.open(\"r\", encoding=\"utf-8\") as f:\n        raw = json.load(f)\n    if isinstance(raw, list):\n        return pd.DataFrame(raw)\n    if isinstance(raw, dict):\n        for key in [\"data\", \"verses\", \"items\", \"records\"]:\n            if key in raw and isinstance(raw[key], list):\n                return pd.DataFrame(raw[key])\n    raise ValueError(\"Unsupported JSON structure\")\n\ndef validate_docs(docs: List[Document]):\n    for i, d in enumerate(docs):\n        if not isinstance(d.page_content, str):\n            raise TypeError(f\"Doc[{i}] page_content not str\")\n        _ = d.page_content.replace(\"\", \"\")\n        if d.metadata is None: d.metadata = {}\n        for k, v in list(d.metadata.items()):\n            if not isinstance(v, (str, int, float, bool)) and v is not None:\n                d.metadata[k] = to_str(v)\n\ndef build_documents(df: pd.DataFrame) -> List[Document]:\n    df = df.fillna(\"\")\n    docs: List[Document] = []\n    for _, r in df.iterrows():\n        row = r.to_dict()\n        docs.append(Document(\n            page_content=build_content(row),\n            metadata={\n                \"id\": to_str(row.get(\"id\")),\n                \"chapter\": to_str(row.get(\"chapter\")),\n                \"verse\": to_str(row.get(\"verse\")),\n            }\n        ))\n    validate_docs(docs)\n    return docs\n\ndef main():\n    if not DATA.exists():\n        raise FileNotFoundError(f\"Input not found: {DATA.resolve()}\")\n    df = load_dataframe()\n    splitter = RecursiveCharacterTextSplitter(\n        chunk_size=700, chunk_overlap=100, separators=[\"\\n\\n\", \"\\n\", \"।\", \".\", \" \"]\n    )\n    docs = build_documents(df)\n    splits = splitter.split_documents(docs)\n    embeddings = HuggingFaceEmbeddings(model_name=EMB_MODEL)\n    db = Chroma.from_documents(\n        splits, embedding=embeddings,\n        persist_directory=str(DB_DIR), collection_name=\"gita\"\n    )\n    db.persist()\n    print(f\"Indexed {len(splits)} chunks into {DB_DIR.resolve()}\")\n\nif __name__ == \"__main__\":\n    main()\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-12-19T03:11: